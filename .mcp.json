{
  "mcpServers": {
    "fal-ai": {
      "type": "http",
      "url": "https://mcp.fal.ai/mcp-relay"
    },
    "elevenlabs": {
      "type": "stdio",
      "command": "uvx",
      "args": ["--env-file", ".env", "elevenlabs-mcp"],
      "env": {
        "ELEVENLABS_MCP_OUTPUT_MODE": "files"
      }
    }
  }
}
